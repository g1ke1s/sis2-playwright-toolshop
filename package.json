{
  "name": "sis2-playwright-toolshop",
  "version": "1.0.0",
  "description": "SIS 2 \u2014 Playwright (TypeScript) acceptance tests for practicesoftwaretesting.com (Toolshop)",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing"
  ],
  "author": "Kenessary Garifulla",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.20.5",
    "typescript": "5.6.3"
  }
}
